# ============================================================================
# CIVIC PULSE — SUPABASE ENVIRONMENT CONFIGURATION
# Cara Penggunaan:
# 1. Salin (copy) file ini dan beri nama `.env` di folder root proyek.
# 2. Isi dengan Project URL dan Anon Public Key dari Supabase Dashboard Anda:
#    (Project Settings -> Data API / API Keys)
# 3. PENTING: Gunakan `anon` / `publishable` key. JANGAN gunakan `service_role`!
# ============================================================================

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
